# Backend
DATABASE_URL="file:./dev.db"
JWT_SECRET="your-super-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
FRONTEND_URL="http://localhost:3000"

# Judge0 API (runs Python & C++; HTML/CSS render in-browser, not here)
# The public endpoint works key-less but throttles — set a key for reliable demos.
JUDGE0_URL="https://ce.judge0.com"
JUDGE0_API_KEY=""
# RapidAPI users: set the host too (e.g. judge0-ce.p.rapidapi.com).
# Self-hosted users: leave JUDGE0_HOST empty (key is sent as X-Auth-Token).
JUDGE0_HOST=""

# Google AI Studio (powers all AI features — get a key at https://aistudio.google.com/apikey)
# Read from the repo-root .env or backend/.env; never hardcode it.
GOOGLE_AI_API_KEY=""
# Optional: override the default model (gemini-2.5-flash)
GOOGLE_AI_MODEL=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

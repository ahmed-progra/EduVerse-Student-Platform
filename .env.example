# ── Environment ──────────────────────────────────────────────────────────────────
# Set to "production" on Railway/Vercel. Controls CORS origins, cookie SameSite,
# security headers, and error verbosity. Omit or set "development" locally.
NODE_ENV="development"

# ── Backend (used by Express) ─────────────────────────────────────────────────────
PORT=4000

# PostgreSQL on Supabase.
# Copy both strings from: Supabase dashboard → Connect → ORMs → Prisma
# DATABASE_URL    = transaction pooler (:6543) for the app (PgBouncer)
# DIRECT_URL      = session pooler    (:5432) for Prisma migrations
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# JWT — signed into an httpOnly cookie. Keep SECRET long (>32 chars) in production.
JWT_SECRET="your-super-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Allowed CORS origin(s). In production, set to the live Vercel domain.
# Multiple: comma-separate (e.g. "https://eduverse.vercel.app,https://eduverse.app").
FRONTEND_URL="http://localhost:3000"

# ── Frontend (used by Next.js at build-time & run-time) ──────────────────────────
# Must match the backend's public URL (Railway/Render domain in production).
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
# Public site origin — canonical URLs, Open Graph tags, sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Judge0 Code Execution ────────────────────────────────────────────────────────
# Public endpoint works key-less but throttles. Get a free key at RapidAPI for demos.
JUDGE0_URL="https://ce.judge0.com"
JUDGE0_API_KEY=""
# RapidAPI users: set HOST (e.g. judge0-ce.p.rapidapi.com).
# Self-hosted users: leave empty (key is sent as X-Auth-Token).
JUDGE0_HOST=""

# ── Google AI Studio (powers all ~28 AI features) ────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=""
# Optional: override the default model (default: gemini-2.5-flash)
GOOGLE_AI_MODEL=""

# ── Google OAuth ─────────────────────────────────────────────────────────────────
# Required for Google sign-in. Create credentials at Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

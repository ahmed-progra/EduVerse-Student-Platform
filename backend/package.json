{
  "name": "@eduverse/backend",
  "description": "EduVerse backend — Express API, Prisma ORM, Gemini AI service, Supabase PostgreSQL",
  "version": "1.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "test:e2e": "node scripts/learning-e2e.mjs && node scripts/mentor-e2e.mjs && node scripts/apprentice-e2e.mjs && node scripts/projects-e2e.mjs && node scripts/teachback-e2e.mjs && node scripts/ai-e2e.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  username       String   @unique
  passwordHash   String
  avatar         String   @default("default")
  bio            String?
  level          Int      @default(1)
  xp             Int      @default(0)       // permanent progression — drives level + leaderboard, never spent
  coins          Int      @default(0)       // spendable shop currency — earned alongside XP
  rank           Int      @default(0)
  placementLevel String   @default("beginner")
  googleId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  progress       UserProgress[]
  xpLogs         XpLog[]
  skills         UserSkill[]
  battlesAs1     Battle[]       @relation("Player1")
  battlesAs2     Battle[]       @relation("Player2")
  battlesWon     Battle[]       @relation("Winner")
  battleSubmissions BattleSubmission[]
  leaderboard    LeaderboardEntry[]
  inventory      UserInventory[]
  placements     CoursePlacement[]
  assessments    Assessment[]
  skillProfiles  SkillProfile[]
  roadmaps       Roadmap[]
  learningEvents LearningEvent[]
  mentorProfile  MentorProfile?
  missions       Mission[]
  mentorReports  MentorReport[]
  projects       Project[]
}

model Course {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  icon        String
  order       Int
  createdAt   DateTime @default(now())

  lessons       Lesson[]
  placements    CoursePlacement[]
  assessments   Assessment[]
  skillProfiles SkillProfile[]
  roadmaps      Roadmap[]
}

model Lesson {
  id           String   @id @default(uuid())
  courseId     String
  title        String
  content      String
  codeTemplate String
  language     String
  order        Int
  xpReward     Int      @default(50)
  topics       String   @default("[]")       // JSON string[] — canonical topic keys this lesson teaches
  difficulty   String   @default("beginner") // beginner | intermediate | advanced
  quiz         String   @default("[]")       // JSON quiz-checkpoint questions
  estMinutes   Int      @default(10)
  createdAt    DateTime @default(now())

  course       Course          @relation(fields: [courseId], references: [id])
  progress     UserProgress[]
}

model CoursePlacement {
  userId   String
  courseId String
  level    String   @default("beginner")
  score    Int      @default(0)
  total    Int      @default(0)
  takenAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@id([userId, courseId])
}

// ── Adaptive learning ──────────────────────────────────────────────

// One row per placement-assessment attempt (question snapshot + AI analysis).
model Assessment {
  id          String    @id @default(uuid())
  userId      String
  courseId    String
  status      String    @default("in_progress") // in_progress | completed
  questions   String    @default("[]")          // JSON: served question ids/order (no answers)
  answers     String    @default("[]")          // JSON: submitted answers
  score       Int       @default(0)
  total       Int       @default(0)
  level       String    @default("")            // beginner | intermediate | advanced
  analysis    String    @default("{}")          // JSON: topic breakdown, strengths, weaknesses, AI narrative
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
}

// Living per-course skill profile: topic -> mastery. Updated continuously.
model SkillProfile {
  userId     String
  courseId   String
  level      String   @default("beginner")
  mastery    String   @default("{}") // JSON: { topic: { status, score } }
  strengths  String   @default("[]")
  weaknesses String   @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@id([userId, courseId])
}

// Personalized lesson plan with per-skip justification. Regenerates as the profile evolves.
model Roadmap {
  userId     String
  courseId   String
  items      String   @default("[]") // JSON: [{ lessonId, status: required|skipped, reason }]
  focus      String   @default("")
  estMinutes Int      @default(0)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@id([userId, courseId])
}

// Analytics trail feeding continuous adaptation (quiz passes/fails, completions).
model LearningEvent {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  lessonId  String?
  type      String   // assessment_complete | lesson_complete | quiz_pass | quiz_fail
  payload   String   @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ── AI Mentor System (global, cross-course coaching layer) ──────────

// Global cross-course AI mentor profile — one per user. The mentor's living memory.
model MentorProfile {
  userId          String    @id
  summary         String    @default("")   // 2-3 sentence "who this learner is right now"
  motivation      String    @default("")   // short motivational line
  focus           String    @default("")   // current recommended focus
  strengths       String    @default("[]") // JSON string[] cross-course strong topics (labels)
  weaknesses      String    @default("[]") // JSON string[] knowledge gaps (labels)
  insights        String    @default("[]") // JSON [{ title, body, kind }]
  recommendations String    @default("[]") // JSON [{ title, reason, area, href }]
  projects        String    @default("[]") // JSON [{ title, brief, skills: string[] }]
  learningSpeed   String    @default("steady") // slow | steady | fast (deterministic)
  retention       Int       @default(0)        // 0-100 quiz-pass consistency
  momentum        Int       @default(0)        // 0-100 recent-activity density
  metrics         String    @default("{}")     // JSON snapshot (counts, growth series, per-course)
  version         Int       @default(0)
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// Dynamic AI-generated missions (daily/weekly) with auto-tracked progress + XP reward.
model Mission {
  id          String    @id @default(uuid())
  userId      String
  scope       String    // daily | weekly
  type        String    // lesson_complete | quiz_pass | battle_win | topic_mastery | assessment | project | xp_earn
  title       String
  description String
  rationale   String    @default("") // why the mentor chose it (AI, grounded in gaps)
  target      Int       @default(1)
  progress    Int       @default(0)
  courseSlug  String?   // null = any course
  topicKey    String?   // for topic_mastery
  difficulty  String?   // for battle_win
  xpReward    Int       @default(50)
  status      String    @default("active") // active | completed
  periodKey   String    // "2026-06-13" (daily) | "2026-W24" (weekly) — uniqueness window
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, scope, periodKey])
}

// AI Project Studio — learners build a real project, AI grades it, it lands on
// their public portfolio. The destination of the learning journey.
model Project {
  id           String    @id @default(uuid())
  userId       String
  title        String
  brief        String                       // what to build
  language     String                       // python | javascript | html | css | cpp
  difficulty   String    @default("beginner")
  skills       String    @default("[]")     // JSON string[] topic keys/labels it demonstrates
  milestones   String    @default("[]")     // JSON [{ text, done }]
  starterCode  String    @default("")
  code         String    @default("")       // learner's working / submitted code
  status       String    @default("in_progress") // in_progress | completed
  source       String    @default("custom") // custom | suggested
  // AI review
  score        Int?                          // 0-100
  feedback     String    @default("")        // narrative
  rubric       String    @default("[]")      // JSON [{ criterion, score, max, note }]
  strengths    String    @default("[]")
  improvements String    @default("[]")
  published    Boolean   @default(true)      // visible on public portfolio when completed
  xpAwarded    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

// Weekly AI learning report snapshots — recurring check-in.
model MentorReport {
  id         String   @id @default(uuid())
  userId     String
  periodKey  String   // "2026-W24"
  narrative  String   @default("")
  improved   String   @default("[]") // JSON string[]
  regressed  String   @default("[]")
  needsWork  String   @default("[]")
  focusAreas String   @default("[]")
  projects   String   @default("[]") // JSON [{ title, brief, skills }]
  metrics    String   @default("{}") // week snapshot (for next week's diff)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, periodKey])
}

model UserProgress {
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  score     Int?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@id([userId, lessonId])
}

model XpLog {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  source    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model SkillTreeNode {
  id             String   @id @default(uuid())
  name           String
  description    String
  branch         String
  positionX      Float
  positionY      Float
  prerequisites  String   @default("[]")
  xpCost         Int
  levelRequired  Int      @default(1)
  effectType     String
  effectValue    Float
  effectDesc     String
  createdAt      DateTime @default(now())

  userSkills     UserSkill[]
}

model UserSkill {
  userId   String
  skillId  String
  unlocked Boolean @default(false)

  user  User           @relation(fields: [userId], references: [id])
  skill SkillTreeNode  @relation(fields: [skillId], references: [id])

  @@id([userId, skillId])
}

model Battle {
  id         String    @id @default(uuid())
  player1Id  String
  player2Id  String?
  challenge  String
  difficulty String
  timeLimit  Int
  status     String    @default("waiting")
  winnerId   String?
  xpReward   Int       @default(0)
  createdAt  DateTime  @default(now())

  player1    User              @relation("Player1", fields: [player1Id], references: [id])
  player2    User?             @relation("Player2", fields: [player2Id], references: [id])
  winner     User?             @relation("Winner", fields: [winnerId], references: [id])
  submissions BattleSubmission[]
}

model BattleSubmission {
  id        String   @id @default(uuid())
  battleId  String
  userId    String
  code      String
  score     Int      @default(0)
  submittedAt DateTime @default(now())

  battle Battle @relation(fields: [battleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model LeaderboardEntry {
  id        String   @id @default(uuid())
  userId    String   @unique
  score     Int      @default(0)
  weekStart String?
  rank      Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model ShopItem {
  id             String   @id @default(uuid())
  name           String
  type           String
  description    String
  price          Int
  levelRequired  Int      @default(1)
  imageUrl       String
  createdAt      DateTime @default(now())

  inventory      UserInventory[]
}

model UserInventory {
  userId   String
  itemId   String
  equipped Boolean @default(false)

  user User     @relation(fields: [userId], references: [id])
  item ShopItem @relation(fields: [itemId], references: [id])

  @@id([userId, itemId])
}
